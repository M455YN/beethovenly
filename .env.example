# Token bota z Discord Developer Portal → Bot
DISCORD_TOKEN=wklej_tutaj_token

# Opcjonalnie: ID serwera, żeby slash-komendy pojawiły się od razu (szybszy sync)
# COMMAND_GUILD_ID=123456789012345678

# Tekst w statusie bota (obok „Słucha”)
BOT_STATUS=/play • beethovenly

# Po ilu sekundach ciszy bot ma wyjść z kanału głosowego (0 = nigdy)
IDLE_DISCONNECT_SECONDS=300

# Limit utworów dodawanych z playlisty
PLAYLIST_LIMIT=50

# Opcjonalna ścieżka do cookies.txt (YouTube 18+/logowanie)
# COOKIES_FILE=/app/data/cookies.txt

# Nie aktualizuj yt-dlp przy starcie kontenera (domyślnie aktualizuje)
# SKIP_YTDLP_UPDATE=1

# Bot token from Discord Developer Portal → Bot
DISCORD_TOKEN=paste_token_here

# Optional: guild ID for immediate slash-command sync
# COMMAND_GUILD_ID=123456789012345678

# Status text shown next to “Listening to”
BOT_STATUS=/play • beethovenly

# Leave voice after this many idle seconds (0 = never)
IDLE_DISCONNECT_SECONDS=300

# Max tracks added from a playlist
PLAYLIST_LIMIT=50

# --- YouTube cookies (OPTIONAL) ---
# Default: off. Playback uses mpv+ytdl then anon yt-dlp (like WagnerBot).
# Only set these if your host IP still gets YouTube bot-check:
# COOKIES_FILE=/app/data/cookies.txt
# COOKIES_FROM_BROWSER=chromium+basictext:/chrome-profile/.config/chromium
# COOKIES_REFRESH=0
# Then: docker compose --profile cookies up -d

# Optional PO token HTTP provider (only with --profile cookies)
# YOUTUBE_POT_BASE_URL=http://127.0.0.1:4416

# Chromium sidecar (profile cookies only)
# CHROMIUM_BIND=127.0.0.1
# CHROMIUM_HTTP_PORT=3000
# CHROMIUM_HTTPS_PORT=3001
# CHROMIUM_USER=admin
# CHROMIUM_PASSWORD=change-me
# PUID=1000
# PGID=1000
# TZ=Europe/Warsaw

# Skip yt-dlp update on container start (updates by default)
# SKIP_YTDLP_UPDATE=1
